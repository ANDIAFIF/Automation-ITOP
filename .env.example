# ================= iTop (internal, tanpa internet) =================
ITOP_BASE_URL=http://10.110.0.24
ITOP_USER=rest_sync
ITOP_PASSWORD=
ITOP_API_VERSION=1.3

# ================= Dashboard (cloud) =================
DASHBOARD_BASE_URL=https://dashboard.defendit360-cloud.sbs
# Harus sama dengan ITOP_SYNC_API_KEY di .env.local dashboard (generate: openssl rand -hex 32)
DASHBOARD_API_KEY=

# ================= Runtime =================
POLL_INTERVAL_SECONDS=60
BATCH_LIMIT=100
# full    = data iTop menang total saat update (field yang iTop tidak punya ikut di-reset)
# partial = sync hanya update field milik iTop (title/status/magnitude/tanggal/note)
OVERWRITE_MODE=full
DATABASE_PATH=sync_state.db

# ================= Logging =================
LOG_LEVEL=INFO
LOG_FILE=logs/itop_sync.log
